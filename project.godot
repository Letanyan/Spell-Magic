; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spell Magic"
run/main_scene="res://Worlds/ShaderLoader/ShaderLoader.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GlobalData="*res://General/globals.gd"
SignalBus="*res://General/SignalBus.gd"
SceneHandler="*res://GUI/Main Menu/SceneHandler.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/confusable_local_declaration=0

[debug_draw_3d]

settings/updates/check_for_updates=false

[display]

window/size/always_on_top=true

[dotnet]

project/assembly_name="Spell Magic"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/repl/plugin.cfg")

[file_customization]

folder_colors={
"res://Audio/": "gray",
"res://Characters/": "red",
"res://GUI/": "green",
"res://Models/": "yellow",
"res://Projectiles/": "pink",
"res://Worlds/": "blue"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://GUI/ThemeUI/ThemeUI.tres"

